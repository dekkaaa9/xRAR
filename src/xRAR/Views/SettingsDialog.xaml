<Window x:Class="xRAR.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="440" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF252526" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Margin="0,0,0,8">
            <!-- General -->
            <TabItem Header="General">
                <StackPanel Margin="8">
                    <CheckBox Content="Show hidden files and folders" Margin="0,4"/>
                    <CheckBox Content="Show grid lines in file list" Margin="0,4"/>
                    <CheckBox Content="Full row select in file list" IsChecked="True" Margin="0,4"/>
                    <CheckBox Content="Single click to open an item" Margin="0,4"/>
                    <Separator Margin="0,8"/>
                    <CheckBox Content="Use large toolbar buttons" IsChecked="True" Margin="0,4"/>
                    <CheckBox Content="Show toolbar tooltips" IsChecked="True" Margin="0,4"/>
                </StackPanel>
            </TabItem>

            <!-- Compression -->
            <TabItem Header="Compression">
                <StackPanel Margin="8">
                    <Label Content="Default compression level:"/>
                    <ComboBox SelectedIndex="3" Style="{StaticResource AddressCombo}" Margin="0,4">
                        <ComboBoxItem Content="Store (0)"/>
                        <ComboBoxItem Content="Fastest (1)"/>
                        <ComboBoxItem Content="Fast (2)"/>
                        <ComboBoxItem Content="Normal (3)"/>
                        <ComboBoxItem Content="Good (4)"/>
                        <ComboBoxItem Content="Best (5)"/>
                    </ComboBox>
                    <Separator Margin="0,8"/>
                    <Label Content="Dictionary size:"/>
                    <ComboBox SelectedIndex="4" Style="{StaticResource AddressCombo}" Margin="0,4">
                        <ComboBoxItem Content="64 KB"/>
                        <ComboBoxItem Content="256 KB"/>
                        <ComboBoxItem Content="1 MB"/>
                        <ComboBoxItem Content="4 MB"/>
                        <ComboBoxItem Content="16 MB"/>
                        <ComboBoxItem Content="32 MB"/>
                        <ComboBoxItem Content="64 MB"/>
                        <ComboBoxItem Content="128 MB"/>
                    </ComboBox>
                    <Separator Margin="0,8"/>
                    <CheckBox Content="Create solid archive by default" Margin="0,4"/>
                </StackPanel>
            </TabItem>

            <!-- Paths -->
            <TabItem Header="Paths">
                <StackPanel Margin="8">
                    <Label Content="Default folder for extracted files:"/>
                    <TextBox Text="" Margin="0,4"/>
                    <Label Content="Temporary folder:"/>
                    <TextBox Text="" Margin="0,4"/>
                    <Label Content="Startup folder:"/>
                    <ComboBox SelectedIndex="0" Style="{StaticResource AddressCombo}" Margin="0,4">
                        <ComboBoxItem Content="Last visited folder"/>
                        <ComboBoxItem Content="Desktop"/>
                        <ComboBoxItem Content="Documents"/>
                        <ComboBoxItem Content="Home"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <!-- Integration -->
            <TabItem Header="Integration">
                <StackPanel Margin="8">
                    <TextBlock Text="File Associations" FontWeight="Bold" Margin="0,0,0,8"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Register xRAR as the default handler for archive files."
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="AssocPanel" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnRegisterAll" Content="Register All" Padding="16,4"
                                Click="BtnRegisterAll_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnUnregisterAll" Content="Unregister All" Padding="16,4"
                                Click="BtnUnregisterAll_Click"/>
                    </StackPanel>
                    <Separator Margin="0,12"/>
                    <CheckBox Content="Add xRAR to desktop context menu" IsChecked="True" Margin="0,4"/>
                    <CheckBox Content="Add xRAR to 'Send to' menu" Margin="0,4"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Style="{StaticResource DialogButton}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
