<Window x:Class="xRAR.Views.AddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add files to archive" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF252526" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Archive name -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Archive:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ArchiveName" Grid.Column="1" IsEditable="True" Height="24"
                      Style="{StaticResource AddressCombo}"/>
            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource DialogButton}"
                    Margin="8,0,0,0" Padding="8,3" Click="BrowseArchive_Click"/>
        </Grid>

        <!-- Format -->
        <GroupBox Grid.Row="1" Header="Archive format" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="4">
                <RadioButton x:Name="RbRar" Content="RAR" IsChecked="True" GroupName="Format" Margin="0,0,16,0"/>
                <RadioButton x:Name="RbZip" Content="ZIP" GroupName="Format"/>
            </StackPanel>
        </GroupBox>

        <!-- Compression -->
        <GroupBox Grid.Row="2" Header="Compression" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <ComboBox x:Name="CmbCompressionLevel" SelectedIndex="3" Style="{StaticResource AddressCombo}">
                    <ComboBoxItem Content="Store (0)"/>
                    <ComboBoxItem Content="Fastest (1)"/>
                    <ComboBoxItem Content="Fast (2)"/>
                    <ComboBoxItem Content="Normal (3)"/>
                    <ComboBoxItem Content="Good (4)"/>
                    <ComboBoxItem Content="Best (5)"/>
                </ComboBox>
                <CheckBox x:Name="ChkSolid" Content="Create solid archive" Margin="0,4,0,0"/>
                <CheckBox x:Name="ChkRecovery" Content="Add recovery record (5%)" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Password -->
        <GroupBox Grid.Row="3" Header="Password" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <PasswordBox x:Name="PwdBox" Height="24" Background="#FF333337" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderBrush}" Padding="4,3"/>
            </StackPanel>
        </GroupBox>

        <!-- Files to add -->
        <GroupBox Grid.Row="4" Header="Files to add" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <TextBlock x:Name="FilesInfo" Text="No files selected" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                <Button Content="Add files..." Style="{StaticResource DialogButton}" HorizontalAlignment="Left"
                        Margin="0,4,0,0" Padding="8,3" Click="AddFiles_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Spacer -->
        <Grid Grid.Row="5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Style="{StaticResource DialogButton}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
